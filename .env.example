# Origin of the PayrollKit API (the Next.js server proxies /api/* to it)
API_ORIGIN=http://127.0.0.1:8000
# Shared secret with the API (its PROXY_IP_SECRET) so rate limits use the real visitor IP
PROXY_IP_SECRET=
# Cookies are Secure in production; set to 0 only to run `next start` over plain http
# COOKIE_SECURE=0
